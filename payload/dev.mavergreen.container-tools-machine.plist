<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.mavergreen.container-tools-machine</string>

  <!-- Enabled by default. A user can turn VM auto-start off via the menu's
       "Start Docker at Login" toggle (docker-machine-ctl login-off = unload -w). -->

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/mavergreen/container-tools/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Silent create: no Terminal window on first run; menu-bar shows "Docker: Starting…". -->
    <key>MAVERICKS_DOCKER_NONINTERACTIVE</key>
    <string>1</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/mavergreen/container-tools/bin/docker-machine-bootstrap</string>
  </array>

  <!-- Bring the VM up at login, then re-check every 60s (recovers after sleep/stop). -->
  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>
</dict>
</plist>

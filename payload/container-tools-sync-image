#!/bin/sh
# platform: macOS-only -- it sources docker-machine-common.sh (osascript, BSD stat -f)
# Post-install helper: the updater runs this (as the user) after installing a new package; it's also
# fine to run by hand. A host copies boot2docker.iso at `docker-machine create` and boots that copy
# forever, so a package update that refreshes the installed ISO doesn't reach the VM until you
# `docker-machine upgrade` it (data disk preserved).
#
# This does two cheap, reliable things when the VM is on an older image -- and nothing else:
#   1. Repoints a Wowfunhappy-migrated host's stale Boot2DockerURL (the old, now-unmounted DMG path)
#      at the installed ISO, so a later upgrade can actually fetch it.
#   2. Posts a NON-modal notification pointing at where the roll happens.
#
# It deliberately does NOT pop a modal dialog or run the upgrade itself. This runs from the updater's
# silently-relaunched process, whose GUI session is unreliable -- the old modal "Upgrade now?" dialog
# silently failed to appear after some updates (dogfooding, 2026-07-31). The roll is user-triggered
# from a reliable context instead: the always-running menu-bar app's "Update VM Image", or the CLI
# `docker-machine-ctl image-upgrade`. Both share the same detection/repoint helpers used here.
set -u
. "${MAVERICKS_DOCKER_COMMON:-/usr/local/mavergreen/container-tools/libexec/docker-machine-common.sh}"

command -v docker-machine >/dev/null 2>&1 || exit 0
[ "$(image_status)" = stale ] || exit 0   # VM absent, or already on the installed image

repoint_iso_url   # make the eventual upgrade fetchable, whether it's triggered from the menu or the CLI
notify image-stale "Container Tools for Mavericks" \
  "A newer Docker VM image is available. Open the menu-bar app and choose \"Update VM Image\", or run: docker-machine-ctl image-upgrade"

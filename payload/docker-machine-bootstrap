#!/bin/sh
# platform: macOS-only -- osascript prompts, and it sources docker-machine-common.sh (osascript, BSD stat -f)
# docker-machine-bootstrap — bring the Docker VM up and keep the docker CLI pointed at it,
# with no shell wiring. Idempotent; always exits 0 (safe for a LaunchAgent on a timer).
# Shared constants/helpers live in docker-machine-common.sh (sourced below).
set -u

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
. "${MAVERICKS_DOCKER_COMMON:-/usr/local/mavergreen/container-tools/libexec/docker-machine-common.sh}"

create_machine() {
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  # Atomic acquire. Returns 1 if another run holds the lock (TOCTOU-safe vs the
  # create_in_progress pre-check) so main can bail instead of touching a half-created VM.
  mkdir "$LOCK" 2>/dev/null || { log "create lock held; skipping create"; return 1; }
  log "creating machine '$MACHINE'"
  if [ "${MAVERICKS_DOCKER_NONINTERACTIVE:-}" = 1 ]; then
    docker-machine create -d vmwarefusion --vmwarefusion-boot2docker-url "$ISO" "$MACHINE" >>"$LOG" 2>&1
    rmdir "$LOCK" 2>/dev/null || true
  else
    notify create "Container Tools for Mavericks" "Creating the Docker VM (one-time, ~1-2 min)..."
    _cmd="docker-machine create -d vmwarefusion --vmwarefusion-boot2docker-url '$ISO' $MACHINE && rmdir '$LOCK' && '$SELF'"
    osascript -e "tell application \"Terminal\" to do script \"$_cmd\"" >/dev/null 2>&1 || true
    osascript -e 'tell application "Terminal" to activate' >/dev/null 2>&1 || true
  fi
  return 0
}

# sync_context() now lives in docker-machine-common.sh (sourced above) — shared with
# docker-machine-ctl so the menu's start/restart/status paths self-heal a DHCP renumber too.

# Neutralize a Wowfunhappy-era shell wiring line (eval "$(docker-machine env default)") by
# commenting it out with a marker -- reversibly: a one-time <profile>.premigrate backup is kept.
# Container Tools points the docker CLI at the VM via a 'mavericks' docker context, so an active
# DOCKER_HOST from the old setup would fight it. Idempotent: the leading '#' the marker adds means
# a second run finds no uncommented match. A residual BARE DOCKER_HOST= (too ambiguous to rewrite)
# still only gets a notification.
neutralize_env_override() {
  for _p in $PROFILES; do
    [ -f "$_p" ] || continue
    if grep -Ev '^[[:space:]]*#' "$_p" 2>/dev/null | grep -Eq 'docker-machine env'; then
      [ -f "$_p.premigrate" ] || cp "$_p" "$_p.premigrate" 2>/dev/null || true
      _tmp="$_p.mm-tmp.$$"
      if sed -E 's|^([[:space:]]*)([^#].*docker-machine env.*)$|\1# Mavergreen container-tools (uses docker context mavericks instead): \2|' \
           "$_p" > "$_tmp" 2>/dev/null; then
        mv -f "$_tmp" "$_p" 2>/dev/null || rm -f "$_tmp" 2>/dev/null || true
        log "commented a 'docker-machine env' line in $_p (backup: $_p.premigrate)"
        notify envmigrated "Container Tools for Mavericks" \
          "Disabled an old 'docker-machine env' line in $(basename "$_p"); Container Tools manages the docker context now."
      else
        rm -f "$_tmp" 2>/dev/null || true
      fi
    fi
    if grep -Ev '^[[:space:]]*#' "$_p" 2>/dev/null | grep -Eq 'DOCKER_HOST='; then
      notify envoverride "Container Tools for Mavericks" \
        "A DOCKER_HOST line in $(basename "$_p") overrides the managed setup; remove it to use Container Tools for Mavericks."
    fi
  done
}

main() {
  if ! fusion_present; then
    log "VMware Fusion not found; skipping"
    notify fusion "Container Tools for Mavericks" "Install VMware Fusion to run the Docker VM."
    write_state no-fusion
    exit 0
  fi
  if create_in_progress; then
    log "create already in progress; skipping this run"
    write_state creating
    exit 0
  fi
  if op_in_progress; then
    log "a ctl operation is in progress; skipping this tick"
    write_state "$(status_word)"   # yields working:<op> — the op owns the machine
    exit 0
  fi
  _status=$(machine_status)
  if [ -z "$_status" ]; then
    if legacy_default_exists; then
      # A Wowfunhappy-era 'default' VM exists and container-tools does not. Carry the data by
      # renaming default -> container-tools (docker-machine-migrate), but ONLY while it is stopped:
      # migrate is irreversible-ish and refuses on a live VM. A running 'default' is left untouched
      # with a nudge to stop it, then this reconciles on the next run.
      if [ "$(docker-machine status default 2>/dev/null)" = "Running" ]; then
        log "legacy 'default' is running; deferring migrate"
        notify migrate "Container Tools for Mavericks" \
          "Found a running 'default' Docker VM. Stop it (docker-machine stop default) and Container Tools will migrate it to container-tools."
        write_state "$(status_word)"
        exit 0
      fi
      if command -v docker-machine-migrate >/dev/null 2>&1; then
        log "auto-migrating legacy 'default' -> container-tools"
        docker-machine-migrate >>"$LOG" 2>&1 || log "migrate reported an error (continuing)"
      else
        log "docker-machine-migrate not found; cannot auto-migrate"
      fi
      _status=$(machine_status)
      if [ -z "$_status" ]; then
        # Migrate produced no container-tools machine; guide the user rather than create a 2nd VM.
        notify migrate "Container Tools for Mavericks" \
          "A 'default' Docker VM exists. Run 'docker-machine-ctl migrate' to rename it to container-tools."
        write_state "$(status_word)"
        exit 0
      fi
    else
      if ! create_machine; then write_state creating; exit 0; fi
      [ "${MAVERICKS_DOCKER_NONINTERACTIVE:-}" = 1 ] || { write_state "$(status_word)"; exit 0; }
      _status=$(machine_status)
    fi
  fi
  [ "$_status" = "Running" ] || docker-machine start "$MACHINE" >>"$LOG" 2>&1 || true
  [ "$(machine_status)" = "Running" ] && sync_context
  neutralize_env_override
  write_state "$(status_word)"
  exit 0
}

main

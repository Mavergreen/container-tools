#!/bin/sh
# platform: macOS-only -- launchctl controls the per-user login LaunchAgent, and it sources docker-machine-common.sh (osascript, BSD stat -f)
# docker-machine-ctl — the command surface the menu-bar app drives. Sources the shared
# helpers; every state-changing verb announces (a notification the menu answers with overview-status).
set -u
# The tree this script belongs to, found from the script's own location (through a link such as
# the one the .pkg puts in its shared bin/), so the same script runs from the .pkg's install and
# from wherever the standalone archive is unpacked.
_s=$0; while [ -L "$_s" ]; do _l=$(readlink "$_s"); case "$_l" in /*) _s=$_l ;; *) _s=$(dirname "$_s")/$_l ;; esac; done
CT_HOME=$(cd "$(dirname "$_s")/.." && pwd -P)
. "${MAVERICKS_DOCKER_COMMON:-$CT_HOME/libexec/docker-machine-common.sh}"

_run_and_announce() { # docker-machine subcommand
  if [ "$1" = start ]; then machine_start; else docker-machine "$1" "$MACHINE"; fi >>"$LOG" 2>&1
  _rc=$?
  # A start/restart can bring the VM up on a new DHCP IP; re-point the context so the menu path
  # self-heals too (not only the login-agent timer). Only once the VM is actually up.
  case "$1" in start|restart) [ "$(machine_status)" = Running ] && sync_context ;; esac
  announce
  return $_rc
}

_refuse_without_room() { # verb  -- end the op and fail if the Mac can't fit the VM's power-on
  host_room_to_boot && return 0
  log "$1 refused: $ROOM_MSG"
  printf '%s\n' "$ROOM_MSG" > "$BOOT_REFUSED" 2>/dev/null || true   # so the menu says why, not just Stopped
  op_end
  exit 1
}

case "${1:-}" in
  status)  status_word ;;
  start)   clear_user_stopped; clear_boot_refused; op_begin start; _refuse_without_room start; _run_and_announce start; _rc=$?; op_end; exit $_rc ;;
  stop)    op_begin stop; _run_and_announce stop; _rc=$?
           [ "$_rc" -eq 0 ] && mark_user_stopped
           op_end; exit $_rc ;;
  restart) clear_user_stopped; clear_boot_refused; op_begin restart; _run_and_announce restart; _rc=$?; op_end; exit $_rc ;;
  image-status) image_status ;;
  resource-status) resource_status ;;
  # Roll the VM onto the freshly-installed boot2docker.iso. Repoint first (a migrated host's stale
  # Boot2DockerURL would make `docker-machine upgrade` fail fetching the vanished DMG), then upgrade
  # (data disk preserved), then bring it up + heal the context. CLI-only; the menu drives this verb.
  # Refused up front when the Mac can't fit the power-on, so a running VM isn't stopped into a pause.
  image-upgrade)
    clear_user_stopped   # it always brings the VM back up
    op_begin image-upgrade
    _refuse_without_room image-upgrade
    repoint_iso_url
    if docker-machine upgrade "$MACHINE" >>"$LOG" 2>&1; then _rc=0; else _rc=$?; fi
    machine_start >>"$LOG" 2>&1 || true   # always bring the VM back up
    [ "$(machine_status)" = Running ] && sync_context
    op_end
    exit $_rc ;;
  login-status) launchctl list "$AGENT_LABEL" >/dev/null 2>&1 && echo on || echo off ;;
  login-on)  launchctl load -w "$AGENT_PLIST" >>"$LOG" 2>&1 ;;
  login-off) launchctl unload -w "$AGENT_PLIST" >>"$LOG" 2>&1 ;;
  disk-status) disk_refresh ;;
  # What "Free Up Space…" would free, and the cleanup itself: unused images and build cache only.
  # Never containers or volumes -- a stopped container or a volume can hold the user's data.
  reclaimable)
    docker --context "$CONTEXT" system df --format '{{.Type}}|{{.Size}}|{{.Reclaimable}}' 2>/dev/null | awk -F'|' '
      $1 == "Images"      { sub(/ .*/, "", $3); print "Unused images: " $3 }
      $1 == "Build Cache" { sub(/ .*/, "", $3); print "Build cache: " $3 }' ;;
  free-space)
    op_begin free-space
    _rc=0
    docker --context "$CONTEXT" image prune -a -f >>"$LOG" 2>&1 || _rc=$?
    docker --context "$CONTEXT" builder prune -f >>"$LOG" 2>&1 || _rc=$?
    _d=$(disk_refresh)
    op_end
    echo "$_d"   # the new disk, for the menu's toast
    exit $_rc ;;
  # What the login agent's tick runs on a low disk (see auto_free_space); fails while another op runs.
  auto-free) auto_free_space ;;
  # What fills the VM's disk and the action that fits (see disk_advice). Reports only.
  disk-advice) disk_advice ;;
  # Enlarge the VM's disk in place (see enlarge_disk); the plan says what would happen, or why not.
  enlarge-disk-plan) enlarge_plan "${2:-}" ;;
  enlarge-disk) enlarge_disk "${2:-}" ;;
  # The user's own size pins it: self-sizing leaves it until `autosize on`.
  resize) shift; if resize_vm "$@"; then autosize_pin; echo "Self-sizing is now off for this VM; docker-machine-ctl autosize on turns it back on."; exit 0; fi; exit 1 ;;
  autosize) autosize_verb "${2:-}"; exit $? ;;
  # Readiness v1 (see readiness_state in docker-machine-common.sh): exit 0 only when Docker answers.
  readiness-version) echo "$READINESS_VERSION" ;;
  readiness|ensure-ready)
    _secs=$([ "$1" = readiness ] && echo 10 || echo 120)
    if [ "${2:-}" = --wait-seconds ]; then _secs=${3:-}; fi
    case "$_secs" in ''|*[!0-9]*) echo "usage: docker-machine-ctl $1 [--wait-seconds N]" >&2; exit 2 ;; esac
    if [ "$1" = readiness ]; then _w=$(readiness_state "$_secs"); echo "$_w"; [ "$_w" = ready ]; exit $?; fi
    ensure_ready "$_secs"; exit $? ;;
  repair) repair; exit $? ;;
  diagnostics) diagnostics ;;
  setup)   clear_user_stopped; exec docker-machine-bootstrap ;;
  migrate) exec docker-machine-migrate ;;
  vmx-pid) vm_pid ;;
  overview-status) overview_status "${2:-}" ;;
  *) echo "usage: docker-machine-ctl {status|start|stop|restart|image-status|image-upgrade|resource-status|disk-status|reclaimable|free-space|auto-free|disk-advice|enlarge-disk-plan|enlarge-disk [GB]|resize [--memory MB] [--cpus N] [--restart]|autosize on|off|status|readiness|ensure-ready|repair|diagnostics|readiness-version|login-status|login-on|login-off|setup|migrate|vmx-pid|overview-status [--full]}" >&2; exit 2 ;;
esac

#!/bin/sh
# platform: macOS-only -- launchctl controls the per-user login LaunchAgent, and it sources docker-machine-common.sh (osascript, BSD stat -f)
# docker-machine-ctl — the command surface the menu-bar app drives. Sources the shared
# helpers; every state-changing verb re-announces via write_state.
set -u
. "${MAVERICKS_DOCKER_COMMON:-/usr/local/mavergreen/container-tools/libexec/docker-machine-common.sh}"

_run_and_announce() { # docker-machine subcommand
  docker-machine "$1" "$MACHINE" >>"$LOG" 2>&1
  _rc=$?
  # A start/restart can bring the VM up on a new DHCP IP; re-point the context so the menu path
  # self-heals too (not only the login-agent timer). Only once the VM is actually up.
  case "$1" in start|restart) [ "$(machine_status)" = Running ] && sync_context ;; esac
  write_state "$(status_word)"
  return $_rc
}

case "${1:-}" in
  status)  _w=$(status_word); write_state "$_w"; echo "$_w" ;;
  start)   clear_user_stopped; op_begin start; _run_and_announce start; _rc=$?; op_end; exit $_rc ;;
  stop)    op_begin stop; _run_and_announce stop; _rc=$?
           [ "$_rc" -eq 0 ] && mark_user_stopped
           op_end; exit $_rc ;;
  restart) clear_user_stopped; op_begin restart; _run_and_announce restart; _rc=$?; op_end; exit $_rc ;;
  image-status) image_status ;;
  # Roll the VM onto the freshly-installed boot2docker.iso. Repoint first (a migrated host's stale
  # Boot2DockerURL would make `docker-machine upgrade` fail fetching the vanished DMG), then upgrade
  # (data disk preserved), then bring it up + heal the context. CLI-only; the menu drives this verb.
  image-upgrade)
    clear_user_stopped   # it always brings the VM back up
    op_begin image-upgrade
    repoint_iso_url
    if docker-machine upgrade "$MACHINE" >>"$LOG" 2>&1; then _rc=0; else _rc=$?; fi
    docker-machine start "$MACHINE" >>"$LOG" 2>&1 || true   # always bring the VM back up
    [ "$(machine_status)" = Running ] && sync_context
    op_end
    exit $_rc ;;
  login-status) launchctl list "$AGENT_LABEL" >/dev/null 2>&1 && echo on || echo off ;;
  login-on)  launchctl load -w "$AGENT_PLIST" >>"$LOG" 2>&1 ;;
  login-off) launchctl unload -w "$AGENT_PLIST" >>"$LOG" 2>&1 ;;
  disk-status) disk_refresh ;;
  # What "Free Up Space…" would free, and the cleanup itself: unused images and build cache only.
  # Never containers or volumes -- a stopped container or a volume can hold the user's data.
  reclaimable)
    docker --context "$CONTEXT" system df --format '{{.Type}}|{{.Size}}|{{.Reclaimable}}' 2>/dev/null | awk -F'|' '
      $1 == "Images"      { sub(/ .*/, "", $3); print "Unused images: " $3 }
      $1 == "Build Cache" { sub(/ .*/, "", $3); print "Build cache: " $3 }' ;;
  free-space)
    op_begin free-space
    _rc=0
    docker --context "$CONTEXT" image prune -a -f >>"$LOG" 2>&1 || _rc=$?
    docker --context "$CONTEXT" builder prune -f >>"$LOG" 2>&1 || _rc=$?
    disk_refresh >/dev/null
    op_end
    exit $_rc ;;
  setup)   clear_user_stopped; exec docker-machine-bootstrap ;;
  migrate) exec docker-machine-migrate ;;
  vmx-pid) pgrep -f "machines/$MACHINE/.*\.vmx" 2>/dev/null | head -1 || true ;;
  *) echo "usage: docker-machine-ctl {status|start|stop|restart|image-status|image-upgrade|disk-status|reclaimable|free-space|login-status|login-on|login-off|setup|migrate|vmx-pid}" >&2; exit 2 ;;
esac

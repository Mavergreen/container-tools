{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Mavergreen/shipyard"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/[^/]+/version$/"
      ],
      "matchStrings": ["REPO=(?<packageName>\\S+?)\\.git\\s+REF=(?<currentValue>\\S+)\\s+DIGEST=(?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "boot2docker's build base (replaces upstream's FROM; see cmake/rebase_dockerfile.sh). A numeric -slim tag, so the next Debian major is proposed, not just digest refreshes.",
      "managerFilePatterns": [
        "/^components/boot2docker/version$/"
      ],
      "matchStrings": ["BASE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/golang/version$/"
      ],
      "matchStrings": ["^(?<currentValue>.+?)\\s*$"],
      "depNameTemplate": "mavericks-golang",
      "packageNameTemplate": "Mavergreen/golang-126",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    }
  ]
}
